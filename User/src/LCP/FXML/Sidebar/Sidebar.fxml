<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="SidebarPane" alignment="TOP_CENTER" styleClass="SidebarUI" stylesheets="@Sidebar.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LCP.FXML.Sidebar.Sidebar">
   <children>
      <ImageView id="profile" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS" />
      <VBox alignment="TOP_CENTER" styleClass="ButtonContainer" VBox.vgrow="ALWAYS">
         <children>
            <Button id="Button" mnemonicParsing="false" onAction="#loadGlobalChat" text="Global Chat" VBox.vgrow="ALWAYS" />
            <Button id="Button" mnemonicParsing="false" onAction="#loadPrivateChat" text="Private Chat" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</VBox>
