<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox id="SidebarPane" fx:id="SidebarPane" prefHeight="600.0" prefWidth="400.0" stylesheets="@Sidebar.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LCP.FXML.Sidebar.Sidebar">
   <children>
      <HBox alignment="CENTER" prefHeight="200.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
         <children>
            <FlowPane id="ImageContainer" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <children>
                  <ImageView id="Image" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../resource/UserProfile.png" />
                     </image>
                     <FlowPane.margin>
                        <Insets />
                     </FlowPane.margin>
                  </ImageView>
               </children>
               <HBox.margin>
                  <Insets bottom="8.0" left="50.0" right="50.0" top="8.0" />
               </HBox.margin>
               <padding>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </padding>
            </FlowPane>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </HBox>
      <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox id="ButtonContainer" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button id="Button" mnemonicParsing="false" onAction="#loadGlobalChat" prefHeight="80.0" prefWidth="350.0" text="Global Chat" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="8.0" top="8.0" />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Button>
                  <Button id="Button" mnemonicParsing="false" onAction="#loadPrivateChat" prefHeight="80.0" prefWidth="350.0" text="Private Chat" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="8.0" top="8.0" />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </padding>
               <VBox.margin>
                  <Insets bottom="8.0" top="8.0" />
               </VBox.margin>
            </VBox>
         </children>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </VBox>
   </children>
</VBox>
